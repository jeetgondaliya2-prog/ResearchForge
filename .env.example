# ResearchForge AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# === LLM API Keys ===
MISTRAL_API_KEY=your_mistral_api_key_here

# === Search API ===
TAVILY_API_KEY=your_tavily_api_key_here

# === Development Mode ===
# Set to true to use mock LLM responses (no API calls)
MOCK_LLM=false

# === LangSmith Tracing (Optional) ===
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=researchforge-ai

# === Database ===
# SQLite (default, no setup needed):
# DATABASE_URL=sqlite:///./researchforge.db
# PostgreSQL (for production):
DATABASE_URL=postgresql://postgres:password@localhost:5432/researchforge

# === Vector Database ===
CHROMA_PERSIST_DIRECTORY=./vector_db
